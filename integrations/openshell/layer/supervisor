# Runs openshell-supervisor on the loader and libraries shipped in this layer,
# so it works whatever libc the rootfs image has. The layer mount point is the
# directory above this script.
root=$(dirname "$(dirname "$0")")
exec "$root/lib/ld-linux-x86-64.so.2" --library-path "$root/lib" "$root/bin/openshell-supervisor" "$@"
